# ================================================================
# Rogologo — environment configuration
# Copy this file to `.env` and fill the values.
# The installer wizard does this for you.
# ================================================================

# ---------- LLM authentication (pick ONE) ----------

# Option A: use your Claude Pro/Max subscription (recommended for personal use).
# Leave ANTHROPIC_API_KEY empty and set USE_SUBSCRIPTION=true.
# You must have run `claude /login` on this machine first.
USE_SUBSCRIPTION=true
ANTHROPIC_API_KEY=

# Option B: use the API directly (recommended for high concurrency / production).
# Set USE_SUBSCRIPTION=false and provide a key from console.anthropic.com.
# USE_SUBSCRIPTION=false
# ANTHROPIC_API_KEY=sk-ant-...

# Default model used when an agent's frontmatter does not specify one.
DEFAULT_MODEL=claude-sonnet-4-6

# ---------- Telegram adapter (optional) ----------

# Get a token from @BotFather on Telegram. Leave empty to disable Telegram.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to talk to the bot.
# Find yours by messaging @userinfobot.
TELEGRAM_ALLOWED_USERS=

# ---------- Slack adapter (optional) ----------

# Slack bot token (xoxb-...) and signing secret. Leave both empty to disable Slack.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# ---------- Database ----------

# Default: SQLite under data/rogologo.db. To use Postgres, switch the URL:
# DATABASE_URL=postgresql+asyncpg://rogologo:rogologo@db:5432/rogologo
DATABASE_URL=sqlite+aiosqlite:///./data/rogologo.db

# ---------- Server ----------

# Bind address & port for the FastAPI core.
CORE_HOST=0.0.0.0
CORE_PORT=8000

# Bind address & port for the Next.js dashboard.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000

# Where the dashboard expects the core API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Agents discovery ----------

# Folder Rogologo watches for agent .md files.
AGENTS_DIR=./agents
SKILLS_DIR=./skills

# How often to rescan the folders (seconds).
DISCOVERY_INTERVAL=5

# ---------- Concurrency ----------

# Max simultaneous agent runs. Subscription users should keep this low (2-3)
# to respect rate limits. API users can go higher.
MAX_CONCURRENT_RUNS=3

# ---------- UI ----------

# Default UI language: en or es.
DEFAULT_LANG=en

# Enable the ant-farm visualization (requires WebGL in the browser).
ANT_FARM_ENABLED=true

# ---------- Telemetry ----------

# Anonymous usage telemetry helps us prioritize features. Opt-in.
TELEMETRY_ENABLED=false

# ---------- Security ----------

# Random secret used to sign session cookies in the dashboard.
# The installer generates a fresh value automatically.
SESSION_SECRET=change-me-to-a-random-32-char-string
