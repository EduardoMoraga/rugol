# ================================================================
# Rugol — environment configuration
# Copy this file to `.env` and fill the values.
# The installer wizard does this for you.
# ================================================================

# ---------- LLM authentication (pick ONE) ----------

# Option A: use your Claude Pro/Max subscription (recommended — no per-use cost).
# Set USE_SUBSCRIPTION=true and paste a long-lived token from `claude setup-token`.
# This token authenticates the bundled `claude` CLI headlessly — it works inside
# Docker and CI, unlike the interactive `claude /login` (whose token lives in the
# OS Keychain on macOS and can't be reached from a container).
USE_SUBSCRIPTION=true
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Option B: use the API directly (isolated billing, also works in Docker).
# Set USE_SUBSCRIPTION=false and provide a key from console.anthropic.com.
# USE_SUBSCRIPTION=false
# ANTHROPIC_API_KEY=sk-ant-...

# Default model used when an agent's frontmatter does not specify one.
DEFAULT_MODEL=claude-sonnet-5

# ---------- Motor Codex (opcional) ----------

# Rugol puede correr agentes con el CLI de OpenAI Codex en vez de Claude.
# Se elige por agente, con `engine: codex` en el frontmatter del .md.
#   1. npm install -g @openai/codex
#   2. rugol login --codex
# Vacío = el CLI usa el login guardado en ~/.codex.
OPENAI_API_KEY=

# Sandbox de Codex: read-only | workspace-write | danger-full-access.
# `workspace-write` escribe sólo en el directorio de trabajo y no tiene red.
# Es el freno principal de este motor, así que subirlo es una decisión.
CODEX_SANDBOX=workspace-write

# Corte duro por corrida, en segundos. 0 = sin límite.
CODEX_TIMEOUT_SECONDS=900

# ---------- Frenos de seguridad ----------

# Los agentes corren con permisos amplios y shell completa, en horarios, sin
# nadie mirando. Estos denies son la única red que hay: borrado recursivo de
# raíz/home, formateo de disco, apagar la máquina, force-push a main,
# DROP DATABASE, borrado de credenciales. Apagarlos es una decisión consciente.
SAFETY_GUARDS_ENABLED=true

# Reglas propias, separadas por `;;`. Son regex.
# Ej: SAFETY_DENY_EXTRA=terraform\s+destroy;;kubectl\s+delete\s+ns
SAFETY_DENY_EXTRA=

# `freeze`: mientras esté seteado, los agentes sólo escriben dentro de esta
# carpeta. Útil para acorralar a un agente que está depurando.
SAFETY_FREEZE_DIR=

# ---------- Telegram adapter (optional) ----------

# Get a token from @BotFather on Telegram. Leave empty to disable Telegram.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to talk to the bot.
# Find yours by messaging @userinfobot.
TELEGRAM_ALLOWED_USERS=

# ---------- Default agent ----------

# Agent that answers instantly on any unbound chat (Telegram, etc.) so
# "token -> chat" works on first contact, Hermes-style. The chat is then
# auto-bound to it (reassign anytime with /bind or in the dashboard).
# Leave empty to keep the strict fleet model (must /bind before chatting).
DEFAULT_AGENT=assistant

# ---------- Slack adapter (optional) ----------

# Slack bot token (xoxb-...) and signing secret. Leave both empty to disable Slack.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# ---------- Database ----------

# Default: SQLite under data/rugol.db. To use Postgres, switch the URL:
# DATABASE_URL=postgresql+asyncpg://rugol:rugol@db:5432/rugol
DATABASE_URL=sqlite+aiosqlite:///./data/rugol.db

# ---------- Server ----------

# Bind address & port for the FastAPI core.
CORE_HOST=0.0.0.0
CORE_PORT=8000

# Bind address & port for the Next.js dashboard.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000

# Where the dashboard expects the core API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Agents discovery ----------

# Folder Rugol watches for agent .md files.
AGENTS_DIR=./agents
SKILLS_DIR=./skills

# How often to rescan the folders (seconds).
DISCOVERY_INTERVAL=5

# ---------- Concurrency ----------

# Max simultaneous agent runs. Subscription users should keep this low (2-3)
# to respect rate limits. API users can go higher.
MAX_CONCURRENT_RUNS=3

# ---------- UI ----------

# Default UI language: en or es.
DEFAULT_LANG=en

# Enable the ant-farm visualization (requires WebGL in the browser).
ANT_FARM_ENABLED=true

# ---------- Telemetry ----------

# Anonymous usage telemetry helps us prioritize features. Opt-in.
TELEMETRY_ENABLED=false

# ---------- Honcho — shared cross-agent memory (optional) ----------

# When true, agents that declare the rugol-honcho MCP server can save,
# query and search observations through Plastic Labs' Honcho service.
# Disabled by default — Rugol runs fully offline-capable without this.
# Sign up at https://honcho.dev to get an API key.
HONCHO_ENABLED=false
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=rugol-default
HONCHO_ENVIRONMENT=production
# Optional. If empty, observations are grouped by today's ISO date.
HONCHO_DEFAULT_SESSION=

# ---------- Security ----------

# Random secret used to sign session cookies in the dashboard.
# The installer generates a fresh value automatically.
SESSION_SECRET=change-me-to-a-random-32-char-string
