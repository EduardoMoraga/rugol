# ── _supervise: proceso foreground que mantiene vivo el stack (para launchd) ──
# launchd MATA los hijos cuando el job termina; por eso 'up' no sirve para
# autostart. Este supervisor se queda corriendo (es el job de launchd), levanta
# backend+dashboard y los reinicia si se caen. launchd lo reinicia a él si muere.
# Supervisor: lo que hace que Rugol vuelva solo. Lo lanza launchd al arrancar
# la máquina (RunAtLoad + KeepAlive), así que apagar y prender no requiere que
# nadie haga nada.
#
# Chequea SALUD, no sólo que el proceso exista. Un core colgado —vivo pero sin
# responder— es el caso que un chequeo por pid no ve, y es justamente el que
# deja el asistente muerto sin que se note. Exigimos 3 fallos seguidos antes de
# reiniciar para no reaccionar a un pico de carga.
cmd_supervise() {
  require_app; require_env
  mkdir -p "$RUN_DIR" "$LOGS_DIR"
  trap 'cmd_down 2>/dev/null; exit 0' TERM INT
  local core_fails=0 dash_fails=0 tolerancia=3

  _log_sup() { echo "$(date '+%Y-%m-%d %H:%M:%S') supervisor: $*" >> "$LOGS_DIR/autostart.log"; }
  _log_sup "arrancado (tolerancia=${tolerancia} chequeos, cada 10s)"

  while :; do
    # ── core ──
    if ! _pid_running "$RUN_DIR/core.pid"; then
      _log_sup "core no está corriendo — lo levanto"
      start_backend; core_fails=0
    elif _core_responds; then
      [ "$core_fails" -gt 0 ] && _log_sup "core volvió a responder"
      core_fails=0
    else
      core_fails=$((core_fails + 1))
      _log_sup "core vivo pero sin responder (${core_fails}/${tolerancia})"
      if [ "$core_fails" -ge "$tolerancia" ]; then
        _log_sup "core colgado — lo reinicio"
        local p; p="$(cat "$RUN_DIR/core.pid" 2>/dev/null)"
        [ -n "$p" ] && kill -9 "$p" 2>/dev/null
        rm -f "$RUN_DIR/core.pid"
        start_backend; core_fails=0
      fi
    fi

    # ── dashboard ──
    if [ -f "$DASH_DIR/.next/standalone/server.js" ]; then
      if ! _pid_running "$RUN_DIR/dashboard.pid"; then
        _log_sup "dashboard no está corriendo — lo levanto"
        start_dashboard; dash_fails=0
      elif curl -fs -m 5 -o /dev/null "http://127.0.0.1:${DASHBOARD_PORT}/" 2>/dev/null; then
        dash_fails=0
      else
        dash_fails=$((dash_fails + 1))
        if [ "$dash_fails" -ge "$tolerancia" ]; then
          _log_sup "dashboard colgado — lo reinicio"
          local d; d="$(cat "$RUN_DIR/dashboard.pid" 2>/dev/null)"
          [ -n "$d" ] && kill -9 "$d" 2>/dev/null
          rm -f "$RUN_DIR/dashboard.pid"
          start_dashboard; dash_fails=0
        fi
      fi
    fi

    sleep 10
  done
}

# ── autostart: levantar Rugol solo al iniciar sesión (launchd) ────────────────
cmd_autostart() {
  local action="${1:-on}"
  local label="ai.increxa.rugol"
  local plist="$HOME/Library/LaunchAgents/${label}.plist"
  local launcher="$HOME/.local/bin/rugol"
  [ -x "$launcher" ] || launcher="$APP_DIR/cli/rugol"
  case "$action" in
    on|enable)
      mkdir -p "$HOME/Library/LaunchAgents" "$LOGS_DIR"
      cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${label}</string>
  <key>ProgramArguments</key>
  <array><string>${launcher}</string><string>_supervise</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${HOME}/.local/bin</string>
    <key>RUGOL_NO_OPEN</key><string>1</string>
  </dict>
  <key>StandardOutPath</key><string>${LOGS_DIR}/autostart.log</string>
  <key>StandardErrorPath</key><string>${LOGS_DIR}/autostart.log</string>
</dict>
</plist>
EOF
      launchctl unload "$plist" 2>/dev/null
      launchctl load "$plist" 2>/dev/null && ok "auto-arranque activado — Rugol se levanta solo al iniciar sesión." \
        || { err "no pude cargar el LaunchAgent."; return 1; }
      say "  ${D}Quitarlo: rugol autostart off${X}"
      ;;
    off|disable)
      launchctl unload "$plist" 2>/dev/null
      rm -f "$plist" && ok "auto-arranque desactivado."
      ;;
    status)
      if [ -f "$plist" ]; then ok "auto-arranque: ACTIVADO ($plist)"; else warn "auto-arranque: desactivado"; fi
      ;;
    *) err "Uso: rugol autostart [on|off|status]" ;;
  esac
}

# ── vault: abrir la memoria de los agentes como vault de Obsidian ─────────────
cmd_vault() {
  require_app
  local mem_root="$APP_DIR/agent-memory"
  if [ ! -d "$mem_root" ] || [ -z "$(ls -A "$mem_root" 2>/dev/null)" ]; then
    warn "Todavía no hay memorias. Hablá con un agente (Telegram o dashboard) y volvé."
    return 0
  fi
  local target="$mem_root"
  if [ -n "${1:-}" ]; then
    local slug; slug="$(echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\+/-/g; s/^-//; s/-$//')"
    if [ -d "$mem_root/$slug" ]; then target="$mem_root/$slug"
    else warn "No hay memorias para '$1' — abro el vault completo (todos los agentes)."; fi
  fi
  echo ""
  say "${B}Vault de memoria:${X} $target"
  local opened=0
  if have open; then
    # macOS: 'open -a Obsidian' usa Launch Services (encuentra la app esté
    # donde esté, no solo en /Applications).
    if open -a Obsidian "$target" 2>/dev/null; then opened=1; fi
  elif have obsidian; then
    obsidian "$target" >/dev/null 2>&1 && opened=1
  fi
  echo ""
  if [ "$opened" -eq 1 ]; then
    say "${D}Primera vez: en Obsidian → 'Open folder as vault' → elegí esa carpeta.${X}"
    say "${D}Después abrí el Graph view (⌘G) para ver la red de memorias.${X}"
  else
    open_url "$target" 2>/dev/null || true
    warn "No pude abrir Obsidian automáticamente."
    say "  Si lo tenés: abrí Obsidian → 'Open folder as vault' → $target"
    say "  Si no: instalalo gratis en ${B}https://obsidian.md${X} (la carpeta ya quedó abierta en Finder)."
  fi
}

# ── bot: gestionar bots de Telegram por proyecto ──────────────────────────────
cmd_bot() {
  require_app; require_env
  local py; py="$(resolve_python)"
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls)
      ( cd "$APP_DIR"; set -a; . "$ENV_FILE"; set +a; "$py" cli/rugol-botctl.py list )
      ;;
    add)
      echo ""
      echo "${B}Conectar un bot de Telegram a un proyecto${X}"
      echo "${D}Creá el bot en @BotFather (/newbot) y pegá su token acá.${X}"
      local token agent label users
      read -r -p "   Token del bot: " token
      [ -z "$token" ] && { err "Sin token, cancelo."; return 1; }
      read -r -p "   Agente que responde en este bot [assistant]: " agent
      agent="${agent:-assistant}"
      read -r -p "   Nombre/etiqueta del bot (ej. Ventas): " label
      read -r -p "   User IDs permitidos (coma-separado, Enter = reusar los del bot 1): " users
      ( cd "$APP_DIR"; set -a; . "$ENV_FILE"; set +a; "$py" cli/rugol-botctl.py add "$token" "$agent" "$label" "$users" ) || return 1
      echo ""
      if _pid_running "$RUN_DIR/core.pid"; then
        say "Reinicio el core para que el bot nuevo arranque..."; cmd_restart
      else
        say "Levantá Rugol con ${B}rugol up${X} y tu bot quedará activo."
      fi
      ;;
    remove|rm)
      local key="${1:-}"
      [ -z "$key" ] && { err "Uso: rugol bot remove <key>  (ver 'rugol bot list')"; return 1; }
      ( cd "$APP_DIR"; set -a; . "$ENV_FILE"; set +a; "$py" cli/rugol-botctl.py remove "$key" ) || return 1
      _pid_running "$RUN_DIR/core.pid" && { say "Reinicio el core..."; cmd_restart; }
      ;;
    *) err "Subcomando desconocido: $sub"; say "  Uso: rugol bot [list|add|remove <key>]" ;;
  esac
}

# ── evolve: self-improving (Soul-3) con vos en el loop ────────────────────────
cmd_evolve() {
  require_app
  local agent="${1:-}"
  [ -z "$agent" ] && { err "Uso: rugol evolve <agente>   (ej. rugol evolve assistant)"; return 1; }
  local base="http://127.0.0.1:${CORE_PORT}"
  _core_responds || { err "El core no responde. Corré ${B}rugol up${X} primero."; return 1; }
  local py; py="$(resolve_python)"
  # Resolver agent_id por nombre.
  local aid
  aid="$(curl -fs "$base/api/agents" | "$py" -c "import sys,json;
d=json.load(sys.stdin)
print(next((a['id'] for a in d if a['name']=='$agent'), ''))" 2>/dev/null)"
  [ -z "$aid" ] && { err "No existe el agente '$agent'. Mirá la lista en el dashboard."; return 1; }
  echo ""
  say "${B}Self-improving${X} — pidiendo a '$agent' que proponga mejoras a su propio prompt..."
  say "${D}(usa Opus; puede tardar ~20-40s)${X}"
  local ids
  ids="$(curl -fs -X POST "$base/api/agents/$aid/evolution/propose?max_candidates=2" | "$py" -c "import sys,json; print(' '.join(json.load(sys.stdin).get('proposed_version_ids',[])))" 2>/dev/null)"
  if [ -z "$ids" ]; then
    echo ""; ok "El agente no propuso cambios (su prompt ya está sólido), o no hubo corridas suficientes."
    return 0
  fi
  echo ""
  ok "Propuestas generadas: $ids"
  curl -fs "$base/api/agents/$aid/evolution" | "$py" -c "
import sys,json
d=json.load(sys.stdin)
for v in d.get('versions',[]):
    if v.get('status')=='proposed':
        print('  • '+v.get('id','?')+'  —  '+ (v.get('hypothesis') or v.get('rationale') or '')[:100])
" 2>/dev/null
  echo ""
  say "${B}Vos decidís.${X} Revisá, validá y aceptá/rechazá cada propuesta en:"
  say "  ${B}http://127.0.0.1:${DASHBOARD_PORT}/agents/$aid/evolution${X}"
  say "${D}Nada se aplica solo: el self-improving siempre te deja la decisión final.${X}"
}

cmd_version() {
  local v=""
  [ -f "$APP_DIR/core/__init__.py" ] && v="$(grep -m1 '__version__' "$APP_DIR/core/__init__.py" 2>/dev/null | sed 's/.*"\(.*\)".*/\1/')"
  echo "rugol ${v:-(desconocida)}"
}

usage() {
  cat <<EOF

${B}rugol${X} — tu orquestador de agentes Claude, en un comando. Sin Docker.

${B}Uso:${X}  rugol <comando>

  ${B}setup${X}        Configuración inicial (auth + modelo + Telegram)
  ${B}login${X}        Conecta tu cuenta de Claude (--token headless · --api-key)
  ${B}logout${X}       Desconecta la cuenta y limpia credenciales del .env
  ${B}auth${X}         Estado real de la cuenta (cuenta, plan, credencial en uso)
  ${B}motor${X}        Ver motores y modelos · cambiar el de un agente
  ${B}up${X}           Levanta core + dashboard y abre el navegador
  ${B}down${X}         Detiene todo
  ${B}restart${X}      Reinicia
  ${B}status${X}       Estado de servicios y salud
  ${B}logs${X} [svc]   Logs en vivo (core | dashboard | boot)
  ${B}doctor${X}       Verifica runtime, puertos y configuración
  ${B}build${X}        (Re)compila el dashboard
  ${B}open${X}         Abre el dashboard
  ${B}update${X}       Actualiza el código y reconstruye (datos intactos)
  ${B}uninstall${X}    Quita rugol (pregunta si borrar datos)

${B}Agentes y memoria:${X}
  ${B}bot${X} [list|add|remove]  Bots de Telegram por proyecto (uno por agente)
  ${B}vault${X} [agente]         Abre la memoria de los agentes como vault de Obsidian
  ${B}evolve${X} <agente>        Self-improving: el agente propone mejorar su prompt (vos aprobás)
  ${B}sessions${X} [filtro]      Tus sesiones de Claude Code + cómo retomarlas
  ${B}autostart${X} [on|off]     Levanta Rugol solo al iniciar sesión

${B}Primera vez:${X}  rugol setup  →  rugol up
${D}Home de datos: $RUGOL_HOME${X}
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    setup)            cmd_setup "$@" ;;
    up|start)         cmd_up "$@" ;;
    down|stop)        cmd_down "$@" ;;
    restart)          cmd_restart "$@" ;;
    status|ps)        cmd_status "$@" ;;
    logs)             cmd_logs "$@" ;;
    doctor)           cmd_doctor "$@" ;;
    build)            cmd_build "$@" ;;
    open)             cmd_open "$@" ;;
    update|upgrade)   cmd_update "$@" ;;
    uninstall)        cmd_uninstall "$@" ;;
    motor|engine)     cmd_motor "$@" ;;
    login)            cmd_login "$@" ;;
    logout)           cmd_logout ;;
    auth)             cmd_auth "$@" ;;
    bot|bots)         cmd_bot "$@" ;;
    vault|memory|mem) cmd_vault "$@" ;;
    evolve|improve)   cmd_evolve "$@" ;;
    sessions|ses)     cmd_sessions "$@" ;;
    autostart)        cmd_autostart "$@" ;;
    _supervise)       cmd_supervise ;;
    version|--version|-v) cmd_version ;;
    help|--help|-h|"") usage ;;
    *) err "Comando desconocido: $cmd"; usage; exit 1 ;;
  esac
}
main "$@"
