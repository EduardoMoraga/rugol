#!/usr/bin/env bash
# rugol — one-command control plane for your Claude agents (Mac/Linux).
# Native: no Docker. The backend runs on a bundled Python (uv-managed) and the
# dashboard on a prebuilt Next.js server. All your state lives in ~/.rugol so
# updates never touch your data. Windows users: see cli/rugol.ps1.
set -uo pipefail

# ── Paths ────────────────────────────────────────────────────────────────────
RUGOL_HOME="${RUGOL_HOME:-$HOME/.rugol}"
APP_DIR="${RUGOL_APP_DIR:-$RUGOL_HOME/app}"
ENV_FILE="$RUGOL_HOME/.env"
DATA_DIR="$RUGOL_HOME/data"
LOGS_DIR="$RUGOL_HOME/logs"
AGENTS_DIR_H="$RUGOL_HOME/agents"
SKILLS_DIR_H="$RUGOL_HOME/skills"
RUN_DIR="$RUGOL_HOME/run"
DASH_DIR="$APP_DIR/dashboard"

# Puertos: gana la variable de entorno, si no el .env, si no el default.
_envget() { [ -f "$ENV_FILE" ] && grep -m1 "^$1=" "$ENV_FILE" 2>/dev/null | cut -d= -f2-; }
CORE_PORT="${CORE_PORT:-$(_envget CORE_PORT)}";          CORE_PORT="${CORE_PORT:-8000}"
DASHBOARD_PORT="${DASHBOARD_PORT:-$(_envget DASHBOARD_PORT)}"; DASHBOARD_PORT="${DASHBOARD_PORT:-3000}"

# ── Pretty output ────────────────────────────────────────────────────────────
if [ -t 1 ]; then
  B=$'\033[1m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; D=$'\033[2m'; X=$'\033[0m'
else
  B=""; G=""; Y=""; R=""; D=""; X=""
fi
ok()   { echo "  ${G}✓${X} $*"; }
warn() { echo "  ${Y}!${X} $*"; }
err()  { echo "  ${R}✗${X} $*" >&2; }
say()  { echo "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

# ── Runtime resolution ───────────────────────────────────────────────────────
resolve_python() {
  local c
  for c in "${RUGOL_VENV:-}/bin/python" "$RUGOL_HOME/runtime/venv/bin/python" "$APP_DIR/.venv/bin/python"; do
    [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return 0; }
  done
  command -v python3 || command -v python
}

resolve_node() {
  local c="$RUGOL_HOME/runtime/node/bin/node"
  [ -x "$c" ] && { echo "$c"; return 0; }
  command -v node
}

require_app() {
  if [ ! -f "$APP_DIR/core/main.py" ]; then
    err "No encuentro la app en $APP_DIR."
    say "    Reinstalá:  curl -fsSL https://raw.githubusercontent.com/EduardoMoraga/rugol/main/installer/install.sh | bash"
    exit 1
  fi
}
# El repositorio de Rugol. Uno solo: el personal de Eduardo. `rugol update`
# comprueba que el clon instalado apunte acá y lo corrige si no — si no, una
# máquina clonada de otro remoto se queda actualizando desde el lugar
# equivocado sin que nada lo diga.
CANONICAL_REPO="${RUGOL_REPO:-https://github.com/EduardoMoraga/rugol.git}"

_norm_repo() { echo "$1" | sed 's/\.git$//; s#/$##' | tr 'A-Z' 'a-z'; }

ensure_origin() {
  local dir="$1" actual
  actual="$(git -C "$dir" remote get-url origin 2>/dev/null)"
  [ "$(_norm_repo "$actual")" = "$(_norm_repo "$CANONICAL_REPO")" ] && return 0
  if [ -n "$actual" ]; then
    warn "el clon apuntaba a $actual"
    git -C "$dir" remote set-url origin "$CANONICAL_REPO" 2>/dev/null
  else
    warn "el clon no tenía 'origin'"
    git -C "$dir" remote add origin "$CANONICAL_REPO" 2>/dev/null
  fi && ok "origin ahora es $CANONICAL_REPO" || err "no pude repuntar origin"
}

require_env() {
  [ -f "$ENV_FILE" ] || { err "Falta configuración. Corré primero:  ${B}rugol setup${X}"; exit 1; }
}

open_url() {
  local url="$1"
  if   have open;     then open "$url" >/dev/null 2>&1 || true
  elif have xdg-open; then xdg-open "$url" >/dev/null 2>&1 || true
  fi
}
rand_secret() {
  if have openssl; then openssl rand -hex 16
  else head -c 32 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 32; fi
}
# ¿El que contesta en el puerto es NUESTRO core?
#
# `curl -fs` sólo falla con 4xx/5xx: un 200 de cualquier app, o un 307 —que
# curl ni siquiera sigue— cuentan como éxito. Medido en vivo: con otra
# aplicación en el puerto, `rugol up` avisaba "el puerto está ocupado por otro
# proceso — no lo toco" y dos líneas después cantaba "core saludable". El core
# nunca había arrancado. La única prueba que sirve es que la respuesta traiga
# la marca del core (core/api/health.py: SERVICE_ID).
_core_responds() {
  local port="${1:-$CORE_PORT}"
  curl -fs -m 5 "http://127.0.0.1:${port}/api/health" 2>/dev/null | grep -q '"service"[[:space:]]*:[[:space:]]*"rugol-core"'
}

wait_for_health() {
  local tries="${1:-30}" i=0
  printf "  esperando al core"
  while [ "$i" -lt "$tries" ]; do
    if _core_responds; then echo ""; return 0; fi
    printf "."; sleep 1; i=$((i+1))
  done
  echo ""; return 1
}

# ── Puertos: adoptar en vez de duplicar ──────────────────────────────────────
# El bug que esto arregla: `rugol down` mata por archivo de pid. Si ese archivo
# quedó desactualizado (un reinicio a medias, un kill -9), el proceso viejo
# sobrevive y se queda con el puerto. Entonces `up` lanza uno nuevo que no puede
# bindear y muere, el archivo de pid apunta a un muerto, y el usuario sigue
# viendo el dashboard VIEJO —código viejo— sin que nada avise.
_pid_on_port() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | head -1
}

# ¿Ese proceso es uno nuestro? Comparamos contra una marca de la línea de
# comandos. Matar un proceso ajeno que casualmente usa el puerto sería peor que
# no arrancar.
_is_ours() {
  local pid="$1" marca="$2"
  [ -n "$pid" ] || return 1
  ps -o command= -p "$pid" 2>/dev/null | grep -q "$marca"
}

# Libera el puerto si lo tiene un proceso NUESTRO que quedó suelto.
_free_port_if_ours() {
  local port="$1" marca="$2" pid
  pid="$(_pid_on_port "$port")"
  [ -n "$pid" ] || return 0
  if _is_ours "$pid" "$marca"; then
    warn "el puerto $port lo tenía un proceso nuestro suelto (pid $pid) — lo cierro"
    kill -9 "$pid" 2>/dev/null
    sleep 1
  else
    warn "el puerto $port está ocupado por otro proceso (pid $pid) — no lo toco"
    return 1
  fi
}

# ── Process management (native, no Docker) ───────────────────────────────────
_pid_running() { local p; p="$(cat "$1" 2>/dev/null)"; [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }

# Rotación de logs. Un asistente 24/7 escribe sin parar: se encontró un
# core.log de 143 MB en una instalación de dos meses. Rotamos al arrancar
# (simple y sin dependencias) y conservamos una generación.
rotate_log() {
  local f="$1" max_mb="${2:-50}" size
  [ -f "$f" ] || return 0
  size=$(( $(wc -c < "$f") / 1048576 ))
  if [ "$size" -ge "$max_mb" ]; then
    mv -f "$f" "$f.1" 2>/dev/null && warn "log rotado ($size MB): $(basename "$f") → $(basename "$f").1"
  fi
}

start_backend() {
  local py; py="$(resolve_python)"
  mkdir -p "$RUN_DIR" "$LOGS_DIR"
  rotate_log "$LOGS_DIR/core.log"
  # Si el puerto ya lo tiene un core nuestro sano, lo ADOPTAMOS en vez de
  # lanzar un duplicado que no va a poder bindear.
  local held; held="$(_pid_on_port "$CORE_PORT")"
  if [ -n "$held" ] && _is_ours "$held" "core.main:app"; then
    if _core_responds; then
      echo "$held" > "$RUN_DIR/core.pid"
      return 0
    fi
  fi
  _free_port_if_ours "$CORE_PORT" "core.main:app" || return 1
  # Cargar .env del usuario y apuntar el estado al home global.
  set -a; . "$ENV_FILE"; set +a
  export AGENTS_DIR="$AGENTS_DIR_H" SKILLS_DIR="$SKILLS_DIR_H"
  # Todo el estado mutable (DB, jobstore del scheduler, settings.json, adjuntos)
  # vive acá, fuera de $APP_DIR: reinstalar borra el código, nunca tus datos.
  export RUGOL_DATA_DIR="$DATA_DIR"
  export DATABASE_URL="${DATABASE_URL:-sqlite+aiosqlite:///$DATA_DIR/rugol.db}"
  # `exec` makes the subshell BECOME the python process, so $! is the real
  # pid (not a wrapper). disown detaches it so it survives this script exiting.
  ( cd "$APP_DIR"; exec "$py" -m uvicorn core.main:app --host 127.0.0.1 --port "$CORE_PORT" \
      >"$LOGS_DIR/core.log" 2>&1 </dev/null ) &
  local pid=$!; echo "$pid" > "$RUN_DIR/core.pid"; disown "$pid" 2>/dev/null || true
}

start_dashboard() {
  local server="$DASH_DIR/.next/standalone/server.js" node; node="$(resolve_node)"
  rotate_log "$LOGS_DIR/dashboard.log"
  [ -f "$server" ] || { warn "Dashboard no compilado — corré 'rugol build' (o 'rugol up' lo hace)."; return 1; }
  [ -n "$node" ] || { err "Node no disponible."; return 1; }
  local held; held="$(_pid_on_port "$DASHBOARD_PORT")"
  if [ -n "$held" ] && _is_ours "$held" "next-server"; then
    if curl -fs -m 3 -o /dev/null "http://127.0.0.1:${DASHBOARD_PORT}/" 2>/dev/null; then
      echo "$held" > "$RUN_DIR/dashboard.pid"
      return 0
    fi
  fi
  _free_port_if_ours "$DASHBOARD_PORT" "next-server" || return 1
  ( cd "$DASH_DIR"; export PORT="$DASHBOARD_PORT" HOSTNAME=127.0.0.1
    exec "$node" "$server" >"$LOGS_DIR/dashboard.log" 2>&1 </dev/null ) &
  local pid=$!; echo "$pid" > "$RUN_DIR/dashboard.pid"; disown "$pid" 2>/dev/null || true
}

# El puerto del core queda HORNEADO en el build del dashboard: next.config.ts
# lee NEXT_PUBLIC_API_URL al compilar y Next serializa el destino del proxy en
# .next/routes-manifest.json. Cambiar CORE_PORT en el .env —que es exactamente
# lo que dice docs/troubleshooting.md cuando el 8000 está ocupado— movía el
# core y dejaba al dashboard hablándole al puerto viejo: todas las páginas
# rotas y ni un mensaje que lo explicara. Medido en vivo: el core sano en 8056
# y el dashboard proxyeando a 8010, que era de otra aplicación.
_dashboard_api_port() {
  local m="$DASH_DIR/.next/routes-manifest.json"
  [ -f "$m" ] || return 1
  local hit
  hit="$(grep -o '"destination":"http://127\.0\.0\.1:[0-9]*' "$m" 2>/dev/null | head -1)"
  [ -n "$hit" ] || return 1
  echo "${hit##*:}"
}

# Recompila si el build apunta a un puerto distinto del que va a usar el core.
# Devuelve 0 si recompiló, 1 si no hizo falta (o si no pudo).
_rebuild_if_port_changed() {
  local baked; baked="$(_dashboard_api_port)" || return 1
  [ "$baked" = "$CORE_PORT" ] && return 1
  warn "el dashboard fue compilado contra el puerto $baked y el core ahora usa $CORE_PORT"
  say "  Recompilo para que el dashboard le hable al core correcto."
  build_dashboard || return 1
  return 0
}

build_dashboard() {
  require_app
  # Usar el Node embebido si existe (instalado por install.sh), si no el del sistema.
  local nodebin="$RUGOL_HOME/runtime/node/bin"
  [ -d "$nodebin" ] && export PATH="$nodebin:$PATH"
  have node || { err "Node no está disponible (lo necesita el dashboard)."; return 1; }
  say "Compilando el dashboard (1-2 min la primera vez)..."
  local built=0
  # Intento 1: pnpm (si está y funciona).
  if have pnpm || corepack enable pnpm 2>/dev/null; then
    if ( cd "$DASH_DIR"
         [ -d node_modules ] || pnpm install
         NEXT_PUBLIC_API_URL="http://127.0.0.1:${CORE_PORT}" pnpm build ); then built=1; fi
  fi
  # Intento 2 (fallback): npm. Cubre el bug de firma de corepack/pnpm
  # ('Cannot find matching keyid') que aparece en varias versiones de Node.
  if [ "$built" -ne 1 ]; then
    warn "pnpm no funcionó — uso npm."
    if ( cd "$DASH_DIR"
         npm install --no-audit --no-fund
         NEXT_PUBLIC_API_URL="http://127.0.0.1:${CORE_PORT}" npm run build ); then built=1; fi
  fi
  [ "$built" -eq 1 ] || { err "Falló el build del dashboard (pnpm y npm)."; return 1; }
  # Next standalone necesita los estáticos al lado del server.
  mkdir -p "$DASH_DIR/.next/standalone/.next"
  cp -R "$DASH_DIR/.next/static" "$DASH_DIR/.next/standalone/.next/static"
  [ -d "$DASH_DIR/public" ] && cp -R "$DASH_DIR/public" "$DASH_DIR/.next/standalone/public" 2>/dev/null
  ok "Dashboard compilado."
}

# Copia los .md de una carpeta de plantillas a la del usuario, sólo si la
# destino está vacía. Silencioso cuando no hay nada que copiar.
_seed_dir() {
  local src="$1" dst="$2" label="$3" n=0
  [ -d "$src" ] || return 0
  [ -z "$(ls -A "$dst" 2>/dev/null)" ] || return 0
  local f
  for f in "$src"/*.md; do
    [ -f "$f" ] || continue
    cp "$f" "$dst/" 2>/dev/null && n=$((n+1))
  done
  [ "$n" -gt 0 ] && ok "$label copiados a $dst ($n)"
  return 0
}

# ── Commands ─────────────────────────────────────────────────────────────────
cmd_setup() {
  require_app
  echo ""
  echo "${B}rugol setup${X} — configuración inicial"
  echo "${D}Enter para aceptar el valor entre [corchetes].${X}"
  echo ""
  mkdir -p "$RUGOL_HOME" "$DATA_DIR" "$LOGS_DIR" "$AGENTS_DIR_H" "$SKILLS_DIR_H" "$RUN_DIR"

  # Semillas opcionales. Sólo `.md`: las carpetas del repo arrancan vacías a
  # propósito (el catálogo de templates vive en core/templates/catalog.py y se
  # clona con un click desde /projects), así que acá casi nunca hay nada que
  # copiar. Antes copiábamos el directorio entero —incluido el `.gitkeep`— y
  # anunciábamos "Agentes de ejemplo copiados" en una instalación que se
  # quedaba con cero agentes. Ahora sólo avisamos si copiamos algo de verdad.
  _seed_dir "$APP_DIR/agents-templates" "$AGENTS_DIR_H" "Agentes de ejemplo"
  _seed_dir "$APP_DIR/skills-templates" "$SKILLS_DIR_H" "Skills de ejemplo"

  # ── Auth ──
  echo "${B}1) Autenticación con Claude${X}"
  echo "   [1] Suscripción Pro/Max  ${D}(recomendado — usa tu plan, sin costo extra)${X}"
  echo "   [2] API key de Anthropic ${D}(pay-per-use, billing aislado)${X}"
  read -r -p "   Opción [1]: " auth_choice
  auth_choice="${auth_choice:-1}"
  local use_sub="true" api_key="" oauth_token=""
  if [ "$auth_choice" = "2" ]; then
    use_sub="false"
    while :; do
      read -rs -p "   ANTHROPIC_API_KEY (sk-ant-...): " api_key; echo ""
      case "$api_key" in
        sk-ant-*) break ;;
        "")  warn "No puede quedar vacío." ;;
        *)   warn "Una API key de Anthropic empieza con 'sk-ant-'. Reintentá." ;;
      esac
    done
  elif have claude; then
    # Claude CLI presente en esta máquina → usamos tu login directo.
    # Token sólo opcional (para correr headless / en un server sin login).
    echo ""
    echo "   ${D}Usaremos tu login de Claude en esta máquina — no necesitás token.${X}"
    read -rs -p "   Token de suscripción (opcional, Enter para usar tu login): " oauth_token; echo ""
  else
    # Sin claude local → hace falta un token long-lived para autenticar.
    echo ""
    echo "   ${D}El CLI 'claude' no está en esta máquina. Generá un token con"
    echo "   'claude setup-token' donde tengas Claude y pegalo acá.${X}"
    while :; do
      read -rs -p "   Token de suscripción: " oauth_token; echo ""
      [ -n "$oauth_token" ] && break || warn "No puede quedar vacío."
    done
  fi

  # ── Modelo ──
  echo ""
  echo "${B}2) Modelo por defecto${X} ${D}(Rugol enruta solo por tarea; este es el fallback)${X}"
  echo "   [1] Sonnet 5 ${D}(recomendado — balance)${X}"
  echo "   [2] Opus 5   ${D}(máxima capacidad)${X}"
  echo "   [3] Haiku 4.5  ${D}(rápido y económico)${X}"
  read -r -p "   Opción [1]: " model_choice
  local model
  case "${model_choice:-1}" in
    2) model="claude-opus-5" ;;
    3) model="claude-haiku-4-5" ;;
    *) model="claude-sonnet-5" ;;
  esac

  # ── Agente por defecto ──
  echo ""
  echo "${B}3) Agente por defecto${X} ${D}(responde al instante, sin /bind)${X}"
  read -r -p "   Agente por defecto [assistant]: " default_agent
  default_agent="${default_agent:-assistant}"

  # ── Telegram (multi-bot) ──
  # Podés conectar VARIOS bots, uno por proyecto. Cada bot sale como un
  # contacto distinto en Telegram y está pegado a su propio agente. El
  # primero usa los campos legacy TELEGRAM_BOT_TOKEN/USERS; si agregás más,
  # se escribe además TELEGRAM_BOTS (JSON) que el backend prioriza.
  echo ""
  echo "${B}4) Telegram${X} ${D}(opcional — Enter para saltar)${X}"
  echo "   ${D}Creá cada bot con @BotFather (/newbot). Podés conectar varios, uno por proyecto.${X}"
  local tg_token tg_users=""
  read -r -p "   Token del bot 1 (Enter = saltar Telegram): " tg_token
  local bots_json=""
  if [ -n "$tg_token" ]; then
    read -r -p "   User IDs permitidos (coma-separado): " tg_users
    local b_agent
    read -r -p "   Agente para este bot [${default_agent}]: " b_agent
    b_agent="${b_agent:-$default_agent}"
    bots_json="{\"token\":\"${tg_token}\",\"agent\":\"${b_agent}\",\"users\":\"${tg_users}\",\"label\":\"Bot 1\"}"
    local n=2
    while true; do
      local more=""
      read -r -p "   ¿Conectar otro bot? Pegá su token (Enter = listo): " more
      [ -z "$more" ] && break
      local ma
      read -r -p "   Agente para el bot ${n} [${default_agent}]: " ma
      ma="${ma:-$default_agent}"
      bots_json="${bots_json},{\"token\":\"${more}\",\"agent\":\"${ma}\",\"users\":\"${tg_users}\",\"label\":\"Bot ${n}\"}"
      n=$((n+1))
    done
  fi

  umask 077
  if [ ! -f "$ENV_FILE" ]; then
    # Primera vez: escribimos el archivo completo, con los comentarios que
    # explican cada clave. Es el único momento en que setup manda sobre el
    # archivo entero.
    local secret; secret="$(rand_secret)"
    cat > "$ENV_FILE" <<EOF
# Generado por \`rugol setup\` — $(date -u +%Y-%m-%dT%H:%M:%SZ)
USE_SUBSCRIPTION=${use_sub}
ANTHROPIC_API_KEY=${api_key}
# Token long-lived de suscripción (claude setup-token) — vacío en modo API key.
CLAUDE_CODE_OAUTH_TOKEN=${oauth_token}
DEFAULT_MODEL=${model}

# Bot principal (legacy / un solo bot). Si conectás varios, manda TELEGRAM_BOTS.
TELEGRAM_BOT_TOKEN=${tg_token}
TELEGRAM_ALLOWED_USERS=${tg_users}
# Varios bots, uno por proyecto (JSON). El backend lo prioriza si no está vacío.
TELEGRAM_BOTS=[${bots_json}]

# Agente que responde al instante en chats sin vincular (Hermes-style).
DEFAULT_AGENT=${default_agent}

CORE_PORT=${CORE_PORT}
DASHBOARD_PORT=${DASHBOARD_PORT}
SESSION_SECRET=${secret}
EOF
  else
    # Ya había configuración: tocamos SÓLO lo que el usuario acaba de
    # contestar. El .env acepta unas 40 claves y setup pregunta por once;
    # reescribir el archivo entero borraba OPENAI_API_KEY, CODEX_*, SAFETY_*,
    # HONCHO_*, SCHEDULER_TIMEZONE, MAX_CONCURRENT_RUNS… sin decir nada, y
    # rotaba el SESSION_SECRET de paso. Medido en vivo.
    local -a kv=(
      "USE_SUBSCRIPTION=${use_sub}"
      "DEFAULT_MODEL=${model}"
      "DEFAULT_AGENT=${default_agent}"
      "CORE_PORT=${CORE_PORT}"
      "DASHBOARD_PORT=${DASHBOARD_PORT}"
    )
    # Credenciales: sólo las que efectivamente escribió. Vaciarlas porque
    # apretó Enter sería desconectarle la cuenta que puso con `rugol login`.
    [ -n "$api_key" ]     && kv+=("ANTHROPIC_API_KEY=${api_key}")
    [ -n "$oauth_token" ] && kv+=("CLAUDE_CODE_OAUTH_TOKEN=${oauth_token}")
    # Telegram: "Enter para saltar" tiene que SALTAR. Antes borraba tus bots.
    if [ -n "$tg_token" ]; then
      kv+=("TELEGRAM_BOT_TOKEN=${tg_token}" "TELEGRAM_ALLOWED_USERS=${tg_users}" "TELEGRAM_BOTS=[${bots_json}]")
    fi
    run_auth env-set "${kv[@]}" >/dev/null || { err "no pude actualizar $ENV_FILE"; return 1; }
  fi
  echo ""
  ok "Configuración guardada en $ENV_FILE"

  # Si Rugol ya estaba corriendo, el proceso vivo tiene la config VIEJA en
  # memoria (el .env solo se lee al arrancar). Reiniciamos para que lo nuevo
  # —token de Telegram, modelo, auth— tome efecto al instante, sin que el
  # usuario tenga que tocar nada más.
  if _pid_running "$RUN_DIR/core.pid" || _pid_running "$RUN_DIR/dashboard.pid"; then
    echo ""
    say "Rugol estaba corriendo — lo reinicio para aplicar la nueva configuración..."
    cmd_restart
  else
    echo ""
    echo "Siguiente:  ${B}rugol up${X}"
  fi
}

cmd_build() { build_dashboard; }

cmd_up() {
  require_app; require_env
  echo ""
  # Build dashboard on first run if needed.
  if [ ! -f "$DASH_DIR/.next/standalone/server.js" ]; then
    build_dashboard || { err "No pude preparar el dashboard."; exit 1; }
  elif _rebuild_if_port_changed; then
    # El build viejo le habla al puerto viejo: hay que reemplazar el proceso.
    _stop_pid "$RUN_DIR/dashboard.pid" "dashboard viejo" >/dev/null 2>&1
  fi
  # Backend
  if _pid_running "$RUN_DIR/core.pid"; then
    ok "core ya estaba corriendo"
  else
    say "Levantando el core..."
    # start_backend falla cuando el puerto lo tiene un proceso ajeno. Seguir
    # de largo era el bug: el dashboard arrancaba contra un core inexistente y
    # el usuario leía "core saludable" porque la otra app contestaba.
    if ! start_backend; then
      err "No levanté el core: el puerto ${CORE_PORT} lo tiene otro programa."
      say "    Cerralo, o cambiá ${B}CORE_PORT${X} en $ENV_FILE y corré ${B}rugol up${X} de nuevo."
      exit 1
    fi
    if wait_for_health 30; then ok "core saludable en http://127.0.0.1:${CORE_PORT}"
    else
      err "El core no respondió en 30s — no arranco el dashboard contra un core caído."
      say "    Mirá:  ${B}rugol logs core${X}"
      exit 1
    fi
  fi
  # Dashboard
  if _pid_running "$RUN_DIR/dashboard.pid"; then
    ok "dashboard ya estaba corriendo"
  else
    start_dashboard && ok "dashboard en http://127.0.0.1:${DASHBOARD_PORT}"
  fi
  local dash="http://127.0.0.1:${DASHBOARD_PORT}"
  if grep -q '^TELEGRAM_BOT_TOKEN=.\+' "$ENV_FILE" 2>/dev/null; then
    ok "Telegram conectado — escribile a tu bot."
  fi
  echo ""
  echo "  ${B}Abrí:  ${dash}${X}"
  # En auto-arranque (launchd) no abrimos el navegador.
  [ -z "${RUGOL_NO_OPEN:-}" ] && open_url "$dash"
  echo ""
  echo "${D}Detener: rugol down  |  Estado: rugol status  |  Logs: rugol logs${X}"
}

_stop_pid() {
  local f="$1" name="$2" p
  p="$(cat "$f" 2>/dev/null)"
  if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then kill "$p" 2>/dev/null; ok "$name detenido"; else say "  $name no estaba corriendo"; fi
  rm -f "$f"
}
cmd_down() {
  _stop_pid "$RUN_DIR/dashboard.pid" "dashboard"
  _stop_pid "$RUN_DIR/core.pid" "core"
  # Y si quedó algo NUESTRO agarrado al puerto (archivo de pid desactualizado),
  # lo soltamos: si no, el próximo `up` lanza un duplicado que no puede bindear
  # y el usuario sigue viendo el proceso viejo.
  _free_port_if_ours "$DASHBOARD_PORT" "next-server" >/dev/null 2>&1
  _free_port_if_ours "$CORE_PORT" "core.main:app" >/dev/null 2>&1
}
cmd_restart() { cmd_down; sleep 1; cmd_up; }

cmd_status() {
  echo ""
  echo "${B}Servicios${X}"
  _pid_running "$RUN_DIR/core.pid"      && ok "core      (pid $(cat "$RUN_DIR/core.pid"))"      || warn "core      detenido"
  _pid_running "$RUN_DIR/dashboard.pid" && ok "dashboard (pid $(cat "$RUN_DIR/dashboard.pid"))" || warn "dashboard detenido"
  echo ""
  echo "${B}Salud${X}"
  if _core_responds; then ok "API  → http://127.0.0.1:${CORE_PORT}"
  elif curl -fs -m 5 "http://127.0.0.1:${CORE_PORT}/api/health" >/dev/null 2>&1; then
    warn "API  → el puerto ${CORE_PORT} responde, pero NO es el core de Rugol (otra app lo tiene)"
  else warn "API  → no responde"; fi
  curl -fs "http://127.0.0.1:${DASHBOARD_PORT}/" >/dev/null 2>&1     && ok "UI   → http://127.0.0.1:${DASHBOARD_PORT}" || warn "UI   → no responde"
  echo ""
  echo "${B}Home${X}   $RUGOL_HOME"
  echo "${B}Config${X} $([ -f "$ENV_FILE" ] && echo "$ENV_FILE" || echo "(falta — corré 'rugol setup')")"
}

cmd_logs() {
  local svc="${1:-core}" f
  case "$svc" in
    dashboard|dash|ui) f="$LOGS_DIR/dashboard.log" ;;
    # El log de la aplicación lo escribe Python (rotativo, con techo). core.log
    # sólo tiene lo que se rompe antes de que el logging esté en pie.
    boot|arranque)     f="$LOGS_DIR/core.log" ;;
    *)                 f="$LOGS_DIR/core.app.log"
                       [ -f "$f" ] || f="$LOGS_DIR/core.log" ;;
  esac
  [ -f "$f" ] && tail -f -n 100 "$f" || warn "sin log todavía: $f"
}

# ── motor: ver y cambiar el motor de los agentes ──────────────────────────────
cmd_motor() {
  require_app
  local base="http://127.0.0.1:${CORE_PORT}"
  _core_responds || { err "El core no responde. Corré 'rugol up' primero."; return 1; }

  # Sin argumentos: estado de los motores + qué usa cada agente.
  if [ $# -eq 0 ]; then
    echo ""
    echo "${B}Motores${X}"
    curl -fs "$base/api/health/engines" | "$(resolve_python)" -c "
import json,sys
for e in json.load(sys.stdin)['engines']:
    if not e['installed']: estado='sin instalar → '+e['install_command']
    elif not e['connected']: estado='sin conectar → '+e['connect_command']
    else: estado='listo'
    mem='memoria: sí' if e['supports_memory'] else 'memoria: NO'
    print(f\"  {e['label']:<22} {estado:<38} {mem}\")
    print('    modelos: ' + ', '.join(m['value'] for m in e.get('models', [])))
"
    echo ""
    echo "${B}Agentes${X}"
    curl -fs "$base/api/agents" | "$(resolve_python)" -c "
import json,sys
for a in sorted(json.load(sys.stdin), key=lambda x: x['name']):
    print(f\"  {a['name']:<24} {a.get('engine','claude'):<8} {a['model']}\")
"
    echo ""
    echo "${D}Cambiar:  rugol motor <agente> <claude|codex>${X}"
    echo ""
    return 0
  fi

  local agente="$1" motor="${2:-}"
  [ -n "$motor" ] || { err "Uso: rugol motor <agente> <claude|codex>"; return 1; }
  "$(resolve_python)" - "$base" "$agente" "$motor" <<'PYEOF'
import json, sys, urllib.request

base, nombre, motor = sys.argv[1], sys.argv[2], sys.argv[3].lower()

def get(path):
    return json.load(urllib.request.urlopen(base + path))

agentes = get("/api/agents")
match = next((a for a in agentes if a["name"] == nombre), None)
if not match:
    print(f"  No existe el agente '{nombre}'. Están: " + ", ".join(a["name"] for a in agentes))
    raise SystemExit(1)

motores = {e["name"]: e for e in get("/api/health/engines")["engines"]}
if motor not in motores:
    print("  Motores válidos: " + ", ".join(motores))
    raise SystemExit(1)
info = motores[motor]
if not info["installed"]:
    print(f"  El CLI de {info['label']} no está instalado.\n  Corré: {info['install_command']}")
    raise SystemExit(1)
if not info["connected"]:
    print(f"  La cuenta de {info['label']} no está conectada.\n  Corré: {info['connect_command']}")
    raise SystemExit(1)

fuente = get(f"/api/agents/{match['id']}/source")
# El modelo salta al default del motor: dejar uno de la otra familia hacía
# fallar la corrida.
payload = {
    "name": match["name"],
    "model": info["default_model"],
    "engine": motor,
    "description": match["description"],
    "body": fuente["body"],
}
req = urllib.request.Request(
    f"{base}/api/agents/{match['id']}", method="PUT",
    data=json.dumps(payload).encode(), headers={"Content-Type": "application/json"},
)
try:
    res = json.load(urllib.request.urlopen(req))
except urllib.error.HTTPError as e:
    # Un traceback de Python no le sirve a nadie: mostramos lo que dijo el API.
    try:
        detalle = json.loads(e.read()).get("detail", "")
    except Exception:
        detalle = ""
    print(f"  No pude guardar el cambio ({e.code}). {detalle}")
    raise SystemExit(1) from None
print(f"  {res['name']} → motor {res['engine']}, modelo {res['model']}")
for falta in info.get("missing") or []:
    print(f"  Ojo: en este motor no está disponible {falta}.")
PYEOF
}

# ── auth: login / logout / status ─────────────────────────────────────────────
# Toda la lógica vive en cli/rugol-auth.py (un solo lugar para Mac/Linux y
# Windows). El script edita el .env clave por clave: `rugol login` no vuelve a
# preguntarte modelo ni token de Telegram, a diferencia de `rugol setup`.
run_auth() {
  # Devuelve (no sale) si algo falta: cmd_doctor lo llama y tiene que poder
  # seguir reportando el resto de los chequeos.
  local py script; py="$(resolve_python)"; script="$APP_DIR/cli/rugol-auth.py"
  [ -f "$APP_DIR/core/main.py" ] || { err "no encuentro la app en $APP_DIR"; return 1; }
  [ -n "$py" ] || { err "no encontré Python — reinstalá con el one-liner del README"; return 1; }
  [ -f "$script" ] || { err "falta cli/rugol-auth.py — corré 'rugol update'"; return 1; }
  RUGOL_HOME="$RUGOL_HOME" RUGOL_DATA_DIR="${RUGOL_DATA_DIR:-$DATA_DIR}" "$py" "$script" "$@"
}

cmd_login()  { run_auth login "$@"; }
cmd_logout() { run_auth logout; }
cmd_auth() {
  # `rugol auth` → status; `rugol auth --verify` → status --verify.
  case "${1:-}" in
    "")  run_auth status ;;
    -*)  run_auth status "$@" ;;
    *)   run_auth "$@" ;;
  esac
}

cmd_doctor() {
  echo ""
  echo "${B}rugol doctor${X}"
  local fail=0 py auth_out who; py="$(resolve_python)"
  [ -n "$py" ] && ok "python: $("$py" --version 2>&1)" || { err "no encontré Python"; fail=1; }
  have node && ok "node: $(node --version)" || { err "node no instalado (lo necesita el dashboard)"; fail=1; }
  have uv && ok "uv: $(uv --version 2>/dev/null)" || warn "uv no está (el instalador lo usa para aislar Python)"
  have claude && ok "claude CLI: $(claude --version 2>/dev/null | head -1)" || warn "claude CLI no está en PATH (OK si usás API key)"
  [ -f "$APP_DIR/core/main.py" ] && ok "app en $APP_DIR" || { err "app no encontrada en $APP_DIR"; fail=1; }
  [ -f "$DASH_DIR/.next/standalone/server.js" ] && ok "dashboard compilado" || warn "dashboard sin compilar — 'rugol build'"
  if [ -f "$ENV_FILE" ]; then
    ok "config presente"
    # Auth de verdad: le preguntamos al CLI de Claude que Rugol realmente
    # ejecuta. Antes esto era un grep del .env — un token vencido pasaba el
    # doctor y después fallaba cada run.
    # --verify hace una llamada real al API: es la única forma honesta de saber
    # si la credencial sirve (`auth status` reporta un token revocado como
    # conectado). Cuesta una fracción de centavo y tarda ~2s; el doctor existe
    # justo para eso.
    say "  ${D}verificando la cuenta de Claude contra el API…${X}"
    if auth_out="$(run_auth status --json --verify 2>/dev/null)"; then
      who="$(printf '%s' "$auth_out" | sed -n 's/.*"account": *"\([^"]*\)".*/\1/p' | head -1)"
      ok "auth: verificada${who:+ ($who)}"
    else
      warn "auth: la cuenta de Claude no funciona — corré 'rugol auth --verify' para el detalle, 'rugol login' para arreglarlo"
      fail=1
    fi

    # Y el motor Codex, si hay agentes que lo usan o el CLI está instalado.
    # `doctor` es el comando de salud: verificar sólo un motor deja al otro roto
    # sin que nada avise.
    if run_auth status --codex --json >/dev/null 2>&1; then
      ok "codex: cuenta conectada"
    elif command -v codex >/dev/null 2>&1; then
      warn "codex: CLI instalado pero la cuenta NO está conectada — corré 'rugol login --codex'"
      fail=1
    else
      say "  ${D}codex: no instalado (OK si no usás ese motor)${X}"
    fi
  else
    warn "falta config — corré 'rugol setup'"
  fi
  echo ""
  [ "$fail" -eq 0 ] && ok "Todo listo." || { err "Resolvé lo de arriba antes de 'rugol up'."; return 1; }
}

cmd_update() {
  require_app
  echo ""
  if [ -d "$APP_DIR/.git" ]; then
    say "Actualizando código..."
    ensure_origin "$APP_DIR"
    # reset --hard al remoto (no 'pull'): un deploy no debe trabarse por
    # archivos que el runtime escribe. Tus datos viven en $RUGOL_HOME, no acá.
    local salida
    if salida="$(git -C "$APP_DIR" fetch --depth 1 origin main 2>&1)" \
       && salida="$(git -C "$APP_DIR" reset --hard origin/main 2>&1)"; then
      ok "código actualizado ($(git -C "$APP_DIR" rev-parse --short HEAD 2>/dev/null))"
    else
      # Decimos QUÉ falló. Culpar a la conexión por cualquier cosa —un repo sin
      # permisos, una rama que no existe— manda a mirar el lugar equivocado.
      err "no pude bajar la última versión desde $CANONICAL_REPO"
      say "$salida"
      warn "sigo con lo instalado."
    fi
  fi
  # Refrescar el launcher donde efectivamente está instalado.
  local bin_dir="$HOME/.local/bin"
  [ "$RUGOL_HOME" = "$HOME/.rugol" ] || bin_dir="$RUGOL_HOME/bin"
  [ -d "$bin_dir" ] && install -m 0755 "$APP_DIR/cli/rugol" "$bin_dir/rugol" 2>/dev/null && ok "launcher actualizado"
  # Deps: el venv lo crea uv (SIN pip) — usar uv para instalar.
  local py; py="$(resolve_python)"
  if have uv && [ -x "$py" ]; then
    uv pip install --python "$py" -q -r "$APP_DIR/core/requirements.txt" \
      && ok "deps backend OK" || warn "deps no actualizadas (seguís con las actuales)"
  elif [ -x "$py" ] && "$py" -m pip --version >/dev/null 2>&1; then
    ( cd "$APP_DIR" && "$py" -m pip install -q -r core/requirements.txt ) \
      && ok "deps backend OK" || warn "deps no actualizadas (seguís con las actuales)"
  else
    warn "no pude actualizar deps (sin uv ni pip) — el backend sigue con las actuales"
  fi
  # Apagar ANTES de compilar: evita servir assets a medio construir.
  cmd_down 2>/dev/null
  build_dashboard
  cmd_up
  ok "rugol actualizado. Tus datos en $RUGOL_HOME quedaron intactos."
}

cmd_uninstall() {
  echo ""
  read -r -p "Detener rugol y ¿borrar también tus DATOS en $RUGOL_HOME? [no/sí]: " ans
  cmd_down 2>/dev/null || true
  if [ "$ans" = "sí" ] || [ "$ans" = "si" ] || [ "$ans" = "yes" ]; then
    rm -rf "$RUGOL_HOME"; ok "home borrado: $RUGOL_HOME"
  else
    say "  Datos conservados en $RUGOL_HOME"
  fi
  rm -f "$HOME/.local/bin/rugol" 2>/dev/null || true
  ok "listo."
}

